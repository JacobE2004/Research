@dataclass
class DataSet:
    path: str
    name: str
    df: pd.DataFrame

# ------------------------------
# I/O utilities
# ------------------------------
COMMENT_PAT = re.compile(r"^\s*[#!;]")

POSSIBLE_JD = ["JD", "HJD", "BJD", "Time", "time", "Julian Date", "julian_date"]
POSSIBLE_MAG = ["Mag", "mag", "Magnitude", "magnitude", "Vmag", "vmag", "MAG"]
POSSIBLE_ERR = ["MagErr", "magerr", "Uncertainty", "uncertainty", "e_mag", "Err", "Error", "MAGERR"]
POSSIBLE_BAND = ["Band", "Filter", "band", "filter"]

NUMERIC_COERCE = ["JD", "HJD", "BJD", "Mag", "mag", "Magnitude", "magnitude", "MagErr", "magerr",
                  "Uncertainty", "uncertainty", "Err", "Error"]


def _strip_comments(raw: str) -> str:
    """Remove pure comment lines to help pandas sniff the dialect."""
    lines = []
    for line in raw.splitlines():
        if COMMENT_PAT.match(line):
            continue
        lines.append(line)
    return "\n".join(lines)


def _read_text_file(path: str) -> pd.DataFrame:
    """Robust loader that tries multiple strategies to read a wide variety of files."""
    with open(path, "r", errors="ignore") as f:
        raw = f.read()

    # Fast path: try pandas with sep auto-sniffing
    try:
        df = pd.read_csv(io.StringIO(raw), sep=None, engine="python")
    except Exception:
        df = None

    if df is None or df.shape[1] <= 1:
        # Strip full-line comments and try again
        try:
            cleaned = _strip_comments(raw)
            df = pd.read_csv(io.StringIO(cleaned), sep=None, engine="python")
        except Exception:
            df = None

    if df is None or df.shape[1] <= 1:
        # Try whitespace-delimited
        try:
            df = pd.read_csv(io.StringIO(raw), delim_whitespace=True, engine="python", comment="#")
        except Exception:
            df = None

    if df is None or df.empty:
        # Ultimate fallback: numpy, then wrap into DataFrame
        try:
            arr = np.genfromtxt(io.StringIO(raw), comments="#;! ")
            if arr.ndim == 1:
                arr = arr.reshape(-1, 1)
            cols = [f"col{i+1}" for i in range(arr.shape[1])]
            df = pd.DataFrame(arr, columns=cols)
        except Exception as e:
            raise ValueError(f"Could not parse file: {os.path.basename(path)} — {e}")

    # Normalize column names by stripping whitespace
    df.columns = [str(c).strip() for c in df.columns]

    # Coerce numeric-like strings (e.g., "<14.2") to NaN; we'll drop non-numeric mags later
    for c in df.columns:
        if c in NUMERIC_COERCE:
            df[c] = pd.to_numeric(df[c], errors="coerce")

    return df


def autodetect_columns(df: pd.DataFrame) -> Dict[str, Optional[str]]:
    """Return a guess for column mapping: {jd, mag, err, band}."""
    cols = list(df.columns)
    lower = {c.lower(): c for c in cols}

    def pick(cands: List[str]) -> Optional[str]:
        # exact preferred
        for c in cands:
            if c in df.columns:
                return c
        # case-insensitive
        for c in cands:
            if c.lower() in lower:
                return lower[c.lower()]
        return None

    jd = pick(POSSIBLE_JD)
    mag = pick(POSSIBLE_MAG)
    err = pick(POSSIBLE_ERR)
    band = pick(POSSIBLE_BAND)

    # If still no luck and we have 3+ numeric columns, assume first three are JD, Mag, MagErr
    if jd is None or mag is None:
        numeric_cols = [c for c in cols if pd.api.types.is_numeric_dtype(df[c])]
        if len(numeric_cols) >= 2:
            jd = jd or numeric_cols[0]
            mag = mag or numeric_cols[1]
            if len(numeric_cols) >= 3:
                err = err or numeric_cols[2]
    return {"jd": jd, "mag": mag, "err": err, "band": band}


