    # ---------- Callbacks ----------
    def open_files(self):
        paths = filedialog.askopenfilenames(title="Open data file(s)",
                                            filetypes=(
                                                ("Data files", "*.csv *.txt *.dat"),
                                                ("All files", "*.*"),
                                            ))
        if not paths:
            return
        for p in paths:
            try:
                df = _read_text_file(p)
            except Exception as e:
                messagebox.showerror("Read error", str(e))
                continue

            name = os.path.basename(p)
            ds = DataSet(path=p, name=name, df=df)
            self.datasets.append(ds)
            self.lb.insert(tk.END, name)

        # Select the last loaded dataset by default
        if self.lb.size() > 0:
            self.lb.select_clear(0, tk.END)
            self.lb.select_set(tk.END)
            self._on_select_dataset()

    def remove_selected(self):
        sel = self.lb.curselection()
        if not sel:
            return
        idx = sel[0]
        self.lb.delete(idx)
        del self.datasets[idx]
        if self.datasets:
            new_idx = min(idx, len(self.datasets) - 1)
            self.lb.select_set(new_idx)
            self._on_select_dataset()
        else:
            self.current = None

    def _on_select_dataset(self, event=None):
        sel = self.lb.curselection()
        if not sel:
            return
        idx = sel[0]
        self.current = self.datasets[idx]

        # Populate mapping comboboxes
        df = self.current.df
        guess = autodetect_columns(df)
        cols = list(df.columns)
        for cb, key in [(self.jd_cb, "jd"), (self.mag_cb, "mag"), (self.err_cb, "err"), (self.band_cb, "band")]:
            cb["values"] = cols
            if guess[key] is not None and guess[key] in cols:
                cb.set(guess[key])
            else:
                cb.set("")

        # Populate band filter dropdown
        if guess["band"] is not None and guess["band"] in df.columns:
            bands = ["ALL"] + sorted([str(x) for x in pd.unique(df[guess["band"]].astype(str)) if x != "nan"])
        else:
            bands = ["ALL"]
        self.band_filter_cb["values"] = bands
        self.band_filter_cb.set("ALL")

    def _get_clean_series(self) -> Tuple[np.ndarray, np.ndarray, Optional[np.ndarray], str]:
        if self.current is None:
            raise RuntimeError("No dataset selected.")
        df = self.current.df.copy()

        jd_col = self.jd_var.get().strip()
        mag_col = self.mag_var.get().strip()
        err_col = self.err_var.get().strip() or None
        band_col = self.band_var.get().strip() or None
        band_pick = self.band_filter_var.get().strip()

        if not jd_col or not mag_col:
            raise RuntimeError("Please map the JD/HJD and Magnitude columns.")

        # If band filter requested
        if band_col and band_pick and band_pick != "ALL" and band_col in df.columns:
            df = df[df[band_col].astype(str) == band_pick]

        # Coerce strings like "<14.2" to NaN when dropping limits
        if self.drop_limits_var.get():
            def _num_only(x):
                try:
                    return float(str(x).replace(",", "."))
                except Exception:
                    # try strip leading comparator
                    s = str(x).strip()
                    s = s.replace("<", "").replace(">", "").replace("~", "")
                    try:
                        return float(s)
                    except Exception:
                        return np.nan
            df[mag_col] = df[mag_col].map(_num_only)

        # Drop rows with NaN in JD or Mag
        df = df[pd.notnull(df[jd_col]) & pd.notnull(df[mag_col])]

        # Remove sentinel bad-magnitude if provided
        bad_text = self.badmag_var.get().strip()
        if bad_text:
            try:
                bad_val = float(bad_text)
                df = df[df[mag_col] != bad_val]
            except ValueError:
                pass  # ignore invalid sentinel

        jd = pd.to_numeric(df[jd_col], errors="coerce").values
        mag = pd.to_numeric(df[mag_col], errors="coerce").values

        if err_col and err_col in df.columns:
            magerr = pd.to_numeric(df[err_col], errors="coerce").values
        else:
            magerr = None

        # Sort by time
        order = np.argsort(jd)
        jd = jd[order]
        mag = mag[order]
        if magerr is not None:
            magerr = (magerr[order] if len(magerr) == len(jd) else None)

        label = self.current.name if band_pick == "ALL" else f"{self.current.name} [{band_pick}]"
        return jd, mag, magerr, label

    def plot_current(self):
        try:
            jd, mag, magerr, label = self._get_clean_series()
        except Exception as e:
            messagebox.showerror("Data error", str(e))
            return

        # Read numeric params
        def _get_float(var: tk.StringVar, name: str) -> float:
            s = var.get().strip()
            if not s:
                raise RuntimeError(f"Please enter {name}.")
            try:
                return float(s)
            except ValueError:
                raise RuntimeError(f"{name} must be a number.")

        try:
            tpeak_JD = _get_float(self.tpeak_var, "t_peak JD")
            m_peak = _get_float(self.mpeak_var, "m_peak")
            t2_JD = _get_float(self.t2jd_var, "t2 JD")
        except Exception as e:
            messagebox.showerror("Parameter error", str(e))
            return

        manual_before = None
        s = self.manual_before_var.get().strip()
        if s:
            try:
                manual_before = float(s)
            except ValueError:
                messagebox.showerror("Parameter error", "manual_tpeak_before must be numeric if provided.")
                return

        if jd.size < 2:
            messagebox.showerror("Not enough data", "Need at least two time points.")
            return

        brackets = compute_brackets(jd, tpeak_JD, t2_JD, manual_before)

        # Plot
        make_plot(self.ax, jd, mag, magerr, tpeak_JD, m_peak, t2_JD, self.title_var.get().strip() or "Light Curve", brackets, label, connect_lines=self.connect_var.get())
        self.canvas.draw()

        # Remember last payload for pop-out and mirror if open
        self._last_plot_payload = (
            jd, mag, magerr, tpeak_JD, m_peak, t2_JD,
            self.title_var.get().strip() or "Light Curve",
            brackets, label, self.connect_var.get()
        )
        if self.popup_ax is not None and self.popup_canvas is not None and self.popup_win is not None and self.popup_win.winfo_exists():
            make_plot(self.popup_ax, jd, mag, magerr, tpeak_JD, m_peak, t2_JD,
                      self.title_var.get().strip() or "Light Curve", brackets, label,
                      connect_lines=self.connect_var.get())
            self.popup_canvas.draw()

        # Print console text in the same style as your script
        self.out.delete("1.0", tk.END)
        self.out.insert(tk.END, "---- Asymmetric uncertainties (quadrature for t2) ----\n")
        self.out.insert(tk.END, f"t_peak uncertainty: -{brackets['gap_before']:.5f} / +{brackets['gap_after']:.5f} days\n")
        self.out.insert(tk.END, f"t2 uncertainty (computed, quadrature): -{brackets['t2_err_before']:.5f} / +{brackets['t2_err_after']:.5f} days\n")
        self.out.insert(tk.END, f"t2 plotted bracket (between neighbouring observations): -{brackets['t2_plot_before']:.5f} / +{brackets['t2_plot_after']:.5f} days\n")
        self.out.insert(tk.END, f"(Reference: quadrature t2 bracket used previously: -{brackets['t2_err_before']:.5f} / +{brackets['t2_err_after']:.5f} days)\n")

        # Extra debug lines (like your printouts)
        self.out.insert(tk.END, f"\n[debug] t2_JD = {t2_JD}\n")
        self.out.insert(tk.END, f"[debug] t2_central (days since peak) = {brackets['t2_central']}\n")
        # Find the nearest observation for t2 and show its days-since-peak for visibility
        idx_t2 = int(np.argmin(np.abs(jd - t2_JD)))
        self.out.insert(tk.END, f"[debug] nearest observation for t2: time[idx_t2] = {jd[idx_t2]} (idx={idx_t2}), days since peak = {jd[idx_t2] - tpeak_JD}\n")

    def save_png(self):
        if self.ax is None:
            return
        path = filedialog.asksaveasfilename(defaultextension=".png",
                                            filetypes=(("PNG", "*.png"), ("All files", "*.*")))
        if not path:
            return
        fig = self.ax.figure
        fig.savefig(path, dpi=200, bbox_inches='tight')
        messagebox.showinfo("Saved", f"Plot saved to:\n{path}")


    def open_popup(self):
        # If already open, just focus it
        if self.popup_win is not None and self.popup_win.winfo_exists():
            self.popup_win.lift()
            return

        # Create new Toplevel window with its own Figure, Axes, Canvas, and Toolbar
        self.popup_win = tk.Toplevel(self)
        self.popup_win.title("Light Curve – Large View")
        self.popup_win.geometry("1100x750")

        fig = plt.Figure(figsize=(10, 6), dpi=100)
        self.popup_ax = fig.add_subplot(111)
        self.popup_canvas = FigureCanvasTkAgg(fig, master=self.popup_win)
        self.popup_canvas.draw()
        self.popup_canvas.get_tk_widget().pack(fill="both", expand=True)
        NavigationToolbar2Tk(self.popup_canvas, self.popup_win)

        def _on_close():
            try:
                if self.popup_win is not None and self.popup_win.winfo_exists():
                    self.popup_win.destroy()
            finally:
                self.popup_win = None
                self.popup_ax = None
                self.popup_canvas = None
        self.popup_win.protocol("WM_DELETE_WINDOW", _on_close)

        # If we already have a plotted state, render it in the pop-out immediately
        if self._last_plot_payload is not None:
            jd, mag, magerr, tpeak_JD, m_peak, t2_JD, title, brackets, label, connect_lines = self._last_plot_payload
            make_plot(self.popup_ax, jd, mag, magerr, tpeak_JD, m_peak, t2_JD, title, brackets, label, connect_lines=connect_lines)
            self.popup_canvas.draw()


