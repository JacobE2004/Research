def compute_brackets(time: np.ndarray, tpeak_JD: float, t2_JD: float,
                      manual_tpeak_before: Optional[float]) -> Dict[str, float]:
    # Find index near peak (closest observation)
    idx_peak = int(np.argmin(np.abs(time - tpeak_JD)))
    n = len(time)

    if idx_peak == 0:
        gap_before = 0.0
        gap_after = float(time[1] - tpeak_JD) if n > 1 else 0.0
    elif idx_peak == n - 1:
        gap_before = float(tpeak_JD - time[n - 2]) if n > 1 else 0.0
        gap_after = 0.0
    else:
        gap_before = float(tpeak_JD - time[idx_peak - 1])
        gap_after  = float(time[idx_peak + 1] - tpeak_JD)

    if manual_tpeak_before is not None and not math.isnan(manual_tpeak_before):
        gap_before = float(manual_tpeak_before)

    # Plotting-only bracket for t_peak (between neighbouring observations)
    idx_plot_after = int(np.searchsorted(time, tpeak_JD))
    idx_plot_before = idx_plot_after - 1

    if idx_plot_before < 0:
        tpeak_plot_before = 0.0
        tpeak_plot_after = float(time[0] - tpeak_JD) if n > 0 else 0.0
    elif idx_plot_after >= n:
        tpeak_plot_before = float(tpeak_JD - time[-1]) if n > 0 else 0.0
        tpeak_plot_after = 0.0
    else:
        tpeak_plot_before = float(tpeak_JD - time[idx_plot_before])
        tpeak_plot_after  = float(time[idx_plot_after] - tpeak_JD)

    # t2 gaps by neighbouring observations around the user t2_JD
    idx_t2 = int(np.argmin(np.abs(time - t2_JD)))
    if idx_t2 == 0:
        t2_gap_before = 0.0
        t2_gap_after  = float(time[1] - t2_JD) if n > 1 else 0.0
    elif idx_t2 == n - 1:
        t2_gap_before = float(t2_JD - time[n - 2]) if n > 1 else 0.0
        t2_gap_after  = 0.0
    else:
        t2_gap_before = float(t2_JD - time[idx_t2 - 1])
        t2_gap_after  = float(time[idx_t2 + 1] - t2_JD)

    t2_gap_before = abs(t2_gap_before)
    t2_gap_after  = abs(t2_gap_after)

    t2_central = float(t2_JD - tpeak_JD)

    # Quadrature asymmetric uncertainties for t2
    t2_err_before = float(np.sqrt(t2_gap_before ** 2 + gap_before ** 2))
    t2_err_after  = float(np.sqrt(t2_gap_after ** 2 + gap_after ** 2))

    # Plotting-only bracket for t2 (between neighbouring observations)
    idx_plot_after_t2 = int(np.searchsorted(time, t2_JD))
    idx_plot_before_t2 = idx_plot_after_t2 - 1

    if idx_plot_before_t2 < 0:
        t2_plot_before = 0.0
        t2_plot_after  = float(time[0] - t2_JD) if n > 0 else 0.0
    elif idx_plot_after_t2 >= n:
        t2_plot_before = float(t2_JD - time[-1]) if n > 0 else 0.0
        t2_plot_after  = 0.0
    else:
        t2_plot_before = float(t2_JD - time[idx_plot_before_t2])
        t2_plot_after  = float(time[idx_plot_after_t2] - t2_JD)

    t2_plot_before = abs(t2_plot_before)
    t2_plot_after  = abs(t2_plot_after)

    return {
        "gap_before": float(gap_before),
        "gap_after": float(gap_after),
        "tpeak_plot_before": float(tpeak_plot_before),
        "tpeak_plot_after": float(tpeak_plot_after),
        "t2_gap_before": float(t2_gap_before),
        "t2_gap_after": float(t2_gap_after),
        "t2_central": float(t2_central),
        "t2_err_before": float(t2_err_before),
        "t2_err_after": float(t2_err_after),
        "t2_plot_before": float(t2_plot_before),
        "t2_plot_after": float(t2_plot_after),
    }


# ------------------------------
# Plotting
# ------------------------------

def make_plot(ax: plt.Axes,
              time: np.ndarray, mag: np.ndarray, magerr: Optional[np.ndarray],
              tpeak_JD: float, m_peak: float, t2_JD: float,
              title: str,
              brackets: Dict[str, float],
              label: str = "data",
              connect_lines: bool = False):
    ax.clear()

    # Shift time to days since peak
    time_shifted = time - tpeak_JD

    # Data points + error bars
    yerr = magerr if magerr is not None else None
    ax.errorbar(time_shifted, mag, yerr=yerr, fmt='o', markersize=6, label=label)

    # Optional: connect observations with a line for easier visual interpolation (e.g., estimating t2)
    if connect_lines:
        ax.plot(time_shifted, mag)

    # Invert Y (magnitudes)
    ax.invert_yaxis()

    # Horizontal lines for m_peak and m_peak + 2
    ax.axhline(m_peak, linestyle='--', color='b', label=f"m_peak = {m_peak:.3f}")
    ax.axhline(m_peak + 2.0, linestyle='--', color='r', label=f"m_peak+2 = {m_peak + 2.0:.3f}")

    # Vertical lines for t_peak (0) and t2
    t2_central = brackets["t2_central"]
    ax.axvline(0, color='k', linestyle='--', label="t_peak = 0", linewidth=1.5, zorder=2)
    ax.axvline(t2_central, color='purple', linestyle='--', label=f"t2 = {t2_central:.2f} d", linewidth=2.0, zorder=2)

    # Shaded brackets (plotting-only)
    ax.axvspan(-brackets["tpeak_plot_before"], brackets["tpeak_plot_after"], color='red', alpha=0.25, zorder=1)
    ax.axvspan(t2_central - brackets["t2_plot_before"], t2_central + brackets["t2_plot_after"], color='cyan', alpha=0.25, zorder=1)

    # Axis cosmetics akin to your script
    ax.set_yticks(np.arange(0, 30, 1))
    ax.set_yticks(np.arange(0, 30, 0.5), minor=True)
    ax.set_xticks(np.arange(-200, 2800, 10))
    ax.set_xticks(np.arange(-200, 2800, 5), minor=True)
    ax.set_ylim(23, 10)
    ax.set_xlim(-20, 180)

    ax.set_xlabel('Days since peak brightness', fontsize=12)
    ax.set_ylabel('Optical Brightness (mag)', fontsize=12)
    ax.set_title(title, fontsize=14)
    ax.legend(loc='upper right', fontsize=9)
    ax.grid(True, which='both', alpha=0.15)


